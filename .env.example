# Supabase (configurar cuando el proyecto esté listo)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# local = datos en el navegador (modo actual)
# supabase = usar backend real (cuando el schema esté aplicado)
VITE_DATA_MODE=local

# Access Token de Credenciales de prueba. Lo lee solo el servidor de desarrollo.
# No uses el prefijo VITE_ y no pongas la contraseña del usuario de prueba.
# En producción cada usuario guarda el suyo, atado a su sesión. No va en este archivo.
MP_ACCESS_TOKEN=
